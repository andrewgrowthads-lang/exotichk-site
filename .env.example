# --- Next.js app (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# --- Next.js app (server-only, never NEXT_PUBLIC_*) ---
# Dedicated expiring robot token for the private Sanity dataset.
# MUST use the Viewer role only; never reuse an Editor/Administrator token.
SANITY_READ_TOKEN=
# Shared secret checked against the `x-sanity-webhook-secret` header
# sent by the Sanity webhook that calls POST /api/revalidate (32+ random characters).
SANITY_REVALIDATE_SECRET=

# Do not add SANITY_AUTH_TOKEN or any write-capable token to the web app.

# --- Sanity Studio (npm run sanity:dev / sanity:deploy) ---
# The Studio's bundler only exposes SANITY_STUDIO_* variables, so these
# duplicate the two public values above under the name it expects.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Origin of the Next.js app for local `sanity dev`. Studio calls POST /api/translate here.
# Not a secret. Never put OPENAI_API_KEY (or any provider key) in SANITY_STUDIO_*.
SANITY_STUDIO_SITE_URL=http://localhost:3000
# HTTPS origin baked into `sanity deploy`. Hosted Studio cannot use localhost.
SANITY_STUDIO_PUBLIC_SITE_URL=https://www.example.com

# --- Translation (server-only, never SANITY_STUDIO_* or NEXT_PUBLIC_*) ---
OPENAI_API_KEY=
