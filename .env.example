# --- Next.js app (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# --- Next.js app (server-only, never NEXT_PUBLIC_*) ---
# Read token for the private Sanity dataset. Viewer role is enough.
SANITY_READ_TOKEN=
# Shared secret checked against the `x-sanity-webhook-secret` header
# sent by the Sanity webhook that calls POST /api/revalidate.
SANITY_REVALIDATE_SECRET=

# --- Sanity Studio (npm run sanity:dev / sanity:deploy) ---
# The Studio's bundler only exposes SANITY_STUDIO_* variables, so these
# duplicate the two public values above under the name it expects.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
